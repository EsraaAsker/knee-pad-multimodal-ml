{
  "dataset": "KneE-PAD",
  "modalities": [
    "IMU",
    "sEMG"
  ],
  "imu_channels": 48,
  "emg_channels": 8,
  "windowing": {
    "imu_window_samples": 593,
    "fixed_stride_samples": 37,
    "emg_window_samples": 5037
  },
  "tasks": {
    "level1_classes": 3,
    "level3_classes": 9,
    "strict_binary_quality_labels": [
      "Correct",
      "Wrong"
    ]
  },
  "validation": {
    "conventional": "trial-level StratifiedKFold before overlapping-window expansion",
    "strict": "participant-grouped outer StratifiedGroupKFold with grouped inner validation for epoch selection"
  },
  "preprocessing": {
    "normalization": "training partition only",
    "augmentation": "small Gaussian signal noise during training"
  },
  "model": {
    "temporal_branches": "EMG and IMU CNN",
    "embedding_dimension": 128,
    "transformer_layers": 2,
    "transformer_heads": 8,
    "feedforward_dimension": 256,
    "attention_pooling": true
  },
  "training": {
    "optimizer": "AdamW",
    "learning_rate": 0.0002,
    "weight_decay": 0.0002,
    "label_smoothing": 0.04,
    "gradient_clipping_norm": 1
  },
  "seeds": {
    "conventional": [
      2026
    ],
    "strict": [
      2026,
      2027,
      2028,
      2029,
      2030
    ]
  }
}
